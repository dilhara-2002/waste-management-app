rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /truck_locations/{truckId} {
      allow read: if true;
      allow write: if true;
    }
  }
}