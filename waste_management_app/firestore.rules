rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCollector() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'collector';
    }

    function isAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidResidentAccessCode(accessCode) {
      return accessCode is string
          && accessCode.matches('^R(00[1-9]|0[1-9][0-9]|100)$');
    }

    function isValidSignupAccessCodeConfig() {
      return request.resource.data.keys().hasOnly(['collector', 'admin', 'updatedAt'])
          && (!('collector' in request.resource.data.keys())
              || (request.resource.data.collector is string
                  && request.resource.data.collector.size() > 0))
          && (!('admin' in request.resource.data.keys())
              || (request.resource.data.admin is string
                  && request.resource.data.admin.size() > 0));
    }

    match /signup_access_codes/{configId} {
      // Signup screens read this before the new user has authenticated.
      allow get: if configId == 'config';
      allow list: if false;
      allow create, update: if configId == 'config'
          && isAdmin()
          && isValidSignupAccessCodeConfig();
      allow delete: if false;
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.role != 'resident'
          || (isSignedIn()
              && request.auth.uid == userId
              && request.resource.data.uid == userId
              && isValidResidentAccessCode(request.resource.data.accessCode)
              && existsAfter(/databases/$(database)/documents/resident_access_codes/$(request.resource.data.accessCode))
              && getAfter(/databases/$(database)/documents/resident_access_codes/$(request.resource.data.accessCode)).data.uid == userId
              && getAfter(/databases/$(database)/documents/resident_access_codes/$(request.resource.data.accessCode)).data.code == request.resource.data.accessCode);
      allow update, delete: if true;
    }

    match /resident_access_codes/{accessCode} {
      allow get: if isSignedIn() && isValidResidentAccessCode(accessCode);
      allow list: if false;
      allow create: if isSignedIn()
          && isValidResidentAccessCode(accessCode)
          && request.resource.data.keys().hasOnly(['uid', 'code', 'claimedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.code == accessCode
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident'
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessCode == accessCode;
      allow update, delete: if false;
    }

    match /truck_locations/{truckId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCollector();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /feedback/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
